{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --global pnpm@10.18.0 && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "framework": null,
  "functions": {
    "api/[...path].ts": {
      "runtime": "nodejs22.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
